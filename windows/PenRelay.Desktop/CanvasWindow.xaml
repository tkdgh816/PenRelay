<Window x:Class="PenRelay.Desktop.CanvasWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:PenRelay.Desktop"
  Title="펜 릴레이 · 캔버스">
  <Grid Padding="16" RowSpacing="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="기기 초대" Click="Invite"/>
      <Button x:Name="ApproveButton" Content="지문 확인 후 승인" IsEnabled="False" Click="Approve"/>
      <Button Content="연결 끊기" Click="Disconnect"/>
    </StackPanel>
    <TextBlock Grid.Row="1" x:Name="HostStatus" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
    <TextBlock Grid.Row="2" x:Name="DocumentStatus" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
    <local:CanvasWorkspace Grid.Row="3" x:Name="Workspace"/>
  </Grid>
</Window>


