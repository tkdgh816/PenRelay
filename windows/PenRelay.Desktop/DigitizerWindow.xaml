<Window x:Class="PenRelay.Desktop.DigitizerWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="펜 릴레이 · 대상 모니터">
  <ScrollViewer>
    <StackPanel Padding="24" Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
      <TextBlock Text="디지타이저 연결" Style="{ThemeResource TitleTextBlockStyle}" />
      <ComboBox x:Name="Target" Header="펜 입력을 받을 모니터" ItemsSource="{x:Bind ViewModel.Monitors}" HorizontalAlignment="Stretch"/>
      <ComboBox x:Name="Address" Header="PC 대기 주소 (ADB USB는 127.0.0.1)" ItemsSource="{x:Bind ViewModel.Addresses}" HorizontalAlignment="Stretch"/>
      <Button Content="호스트 열기" Click="StartHost"/>
      <TextBlock x:Name="Status" TextWrapping="Wrap" Text="호스트 창에서 기기를 승인하고 태블릿에서 ‘디지타이저’를 선택하세요."/>
    </StackPanel>
  </ScrollViewer>
</Window>
