<UserControl x:Class="PenRelay.Desktop.CanvasWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PenRelay.Desktop">
  <Grid x:Name="CanvasLayout"
        RowSpacing="4"
        ColumnSpacing="12"
        SizeChanged="ResizeLibrary">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="ListColumn"
                        Width="172" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid x:Name="Sidebar"
          Grid.RowSpan="4"
          RowSpacing="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Text="페이지"
                 Style="{ThemeResource SubtitleTextBlockStyle}" />
      <ListView x:Name="Library"
                Grid.Row="1"
                SelectionMode="Single"
                SelectionChanged="SelectPage"
                AutomationProperties.Name="페이지 보관함" />
    </Grid>
    <Grid x:Name="ToolbarRow"
          Grid.Column="1"
          Grid.Row="1"
          SizeChanged="ToolbarResized">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>
      <ContentPresenter x:Name="NavigationCommands"
                        VerticalAlignment="Center" />
      <TextBlock x:Name="CurrentPageTitle"
                 Grid.Column="1"
                 Style="{ThemeResource BodyStrongTextBlockStyle}"
                 TextAlignment="Center"
                 VerticalAlignment="Center"
                 Margin="4,0"
                 MaxLines="1"
                 TextTrimming="CharacterEllipsis" />
      <CommandBar x:Name="Commands"
                  Grid.ColumnSpan="3"
                  DefaultLabelPosition="Right"
                  Background="Transparent">
        <AppBarToggleButton x:Name="OverlayButton"
                            Icon="OpenPane"
                            Label="오버레이"
                            Click="OverlayClick"
                            Visibility="Collapsed" />
        <AppBarButton x:Name="SavePage"
                      Icon="Save"
                      Label="페이지 저장"
                      Click="SaveClick"
                      IsEnabled="False" />
        <AppBarButton x:Name="CopyPage"
                      Icon="Copy"
                      Label="복사"
                      Click="CopyClick"
                      IsEnabled="False" />
        <AppBarButton x:Name="ExportFormats"
                      Icon="SaveLocal"
                      Label="내보내기"
                      IsEnabled="False">
          <AppBarButton.Flyout>
            <MenuFlyout>
              <MenuFlyoutItem Text="PNG 내보내기"
                              Click="ExportClick" />
              <MenuFlyoutItem x:Name="ExportSvg"
                              Text="SVG 내보내기"
                              Click="ExportSvgClick"
                              IsEnabled="False" />
            </MenuFlyout>
          </AppBarButton.Flyout>
        </AppBarButton>
        <AppBarButton x:Name="SharePage"
                      Icon="Share"
                      Label="공유"
                      Click="ShareClick"
                      IsEnabled="False" />
      </CommandBar>
    </Grid>
    <ContentPresenter x:Name="NavigationSlot"
                      Grid.Row="2"
                      Grid.ColumnSpan="2"
                      HorizontalContentAlignment="Stretch" />
    <Grid x:Name="Drawing"
          Grid.Row="3"
          Grid.Column="1"
          Background="#E6E5E9"
          CornerRadius="8">
      <local:CanvasViewer x:Name="Live" />
      <StackPanel x:Name="Empty"
                  Spacing="8"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Padding="16"
                  RequestedTheme="Light">
        <SymbolIcon Symbol="Pictures" />
        <TextBlock Text="태블릿의 페이지를 기다리는 중"
                   FontSize="20"
                   FontWeight="SemiBold"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
        <TextBlock Text="태블릿을 연결하면 저장한 페이지가 여기에 표시됩니다."
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
    <TextBlock Grid.Row="4"
               Grid.ColumnSpan="2"
               x:Name="Feedback"
               TextWrapping="Wrap"
               AutomationProperties.LiveSetting="Polite" />
  </Grid>
</UserControl>
